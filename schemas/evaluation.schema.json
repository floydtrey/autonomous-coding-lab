{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-model-bench.invalid/schemas/evaluation.schema.json",
  "title": "Local Model Bench deterministic evaluation report",
  "type": "object",
  "required": ["schema_version", "generated_at", "run_id", "note", "models", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string"},
    "run_id": {"type": ["string", "null"]},
    "note": {"type": "string"},
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["model_id", "evaluated_cases", "hard_failures", "deterministic_score", "maximum_score", "percent"]
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["model_id", "suite_id", "case_id", "deterministic_score", "maximum_score", "hard_fail", "checks"]
      }
    }
  },
  "additionalProperties": false
}
