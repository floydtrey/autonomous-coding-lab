{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-model-bench.invalid/schemas/result.schema.json",
  "title": "Local Model Bench case result",
  "type": "object",
  "required": [
    "schema_version", "status", "sequence", "suite_id", "case_id", "model",
    "request", "response", "tokens", "timing", "attempts", "started_at", "finished_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["success", "error"]},
    "sequence": {"type": "integer", "minimum": 1},
    "suite_id": {"type": "string"},
    "case_id": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "case_metadata": {"type": "object"},
    "context": {
      "type": "object",
      "required": ["mode", "group"],
      "properties": {
        "mode": {"enum": ["isolated", "preserve"]},
        "group": {"type": ["string", "null"]}
      }
    },
    "model": {
      "type": "object",
      "required": ["id", "name", "provider"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "provider": {"type": "string"}
      }
    },
    "request": {
      "type": "object",
      "required": ["messages", "options"],
      "properties": {
        "messages": {"type": "array"},
        "options": {"type": "object"}
      }
    },
    "response": {
      "type": ["object", "null"],
      "properties": {
        "content": {"type": "string"},
        "finish_reason": {"type": ["string", "null"]},
        "raw": {"type": "object"}
      }
    },
    "tokens": {
      "type": "object",
      "properties": {
        "prompt": {"type": ["integer", "null"]},
        "output": {"type": ["integer", "null"]},
        "total": {"type": ["integer", "null"]}
      }
    },
    "timing": {
      "type": "object",
      "required": ["wall_seconds"],
      "properties": {
        "wall_seconds": {"type": "number"},
        "provider_total_seconds": {"type": ["number", "null"]},
        "load_seconds": {"type": ["number", "null"]},
        "prompt_eval_seconds": {"type": ["number", "null"]},
        "generation_seconds": {"type": ["number", "null"]},
        "output_tokens_per_second": {"type": ["number", "null"]}
      }
    },
    "attempts": {"type": "array", "minItems": 1},
    "error": {"type": "object"},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"}
  },
  "additionalProperties": true
}

