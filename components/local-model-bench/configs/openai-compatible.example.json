{
  "schema_version": 1,
  "result_root": "../results",
  "suites": ["../suites/sample.json"],
  "providers": {
    "lm-studio": {
      "type": "openai_compatible",
      "base_url": "http://localhost:1234/v1"
    },
    "jan": {
      "type": "openai_compatible",
      "base_url": "http://localhost:1337/v1",
      "api_key_env": "LOCAL_MODEL_API_KEY"
    }
  },
  "models": [
    {
      "id": "lm-studio-model",
      "provider": "lm-studio",
      "name": "replace-with-server-model-id",
      "options": {
        "temperature": 0,
        "seed": 42,
        "max_tokens": 1024
      }
    }
  ],
  "run": {
    "timeout_seconds": 900,
    "retries": 1,
    "retry_delay_seconds": 5,
    "unload_after_model": false
  }
}

