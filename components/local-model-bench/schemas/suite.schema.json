{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-model-bench.invalid/schemas/suite.schema.json",
  "title": "Local Model Bench JSON prompt suite",
  "type": "object",
  "required": ["suite_id", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "suite_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "name": {"type": "string", "minLength": 1},
    "defaults": {
      "type": "object",
      "properties": {
        "context_mode": {"enum": ["isolated", "preserve"]},
        "context_group": {"type": "string"},
        "system": {"type": "string"},
        "options": {"type": "object"}
      },
      "additionalProperties": true
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "prompt": {"type": "string", "minLength": 1},
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["role", "content"],
              "properties": {
                "role": {"enum": ["system", "user", "assistant"]},
                "content": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "system": {"type": "string"},
          "context": {
            "oneOf": [
              {"enum": ["isolated", "preserve"]},
              {
                "type": "object",
                "required": ["mode"],
                "properties": {
                  "mode": {"enum": ["isolated", "preserve"]},
                  "group": {"type": "string"}
                },
                "additionalProperties": false
              }
            ]
          },
          "tags": {"type": "array", "items": {"type": "string"}},
          "options": {"type": "object"},
          "evaluation": {
            "type": "object",
            "required": ["kind", "expected_status", "requirement_ids"],
            "properties": {
              "kind": {"enum": ["plan", "task_set"]},
              "expected_status": {"enum": ["ready", "blocked"]},
              "requirement_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "max_items": {"type": "integer", "minimum": 0},
              "forbidden_substrings": {"type": "array", "items": {"type": "string"}},
              "semantic_checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["label", "any_of"],
                  "properties": {
                    "label": {"type": "string"},
                    "any_of": {"type": "array", "minItems": 1, "items": {"type": "string"}}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "oneOf": [
          {"required": ["prompt"], "not": {"required": ["messages"]}},
          {"required": ["messages"], "not": {"required": ["prompt"]}}
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
