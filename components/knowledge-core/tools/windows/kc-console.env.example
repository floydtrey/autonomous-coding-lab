# Copy this file outside the repository. Do not commit the populated file.
# Default daily-launcher location:
# %LOCALAPPDATA%\KnowledgeCore\console-v1\console.env

KNOWLEDGE_CORE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:PORT/DATABASE
KNOWLEDGE_CORE_ARTIFACT_ROOT=C:\absolute\path\to\existing\artifacts
KNOWLEDGE_CORE_BOOTSTRAP_KEY=existing-private-bootstrap-key
KNOWLEDGE_CORE_BIND_HOST=127.0.0.1
KNOWLEDGE_CORE_PORT=8765

KNOWLEDGE_CORE_CONSOLE_ENABLED=true
KNOWLEDGE_CORE_CONSOLE_KEY=separate-private-owner-key
KNOWLEDGE_CORE_CONSOLE_PROJECTS=inbox
KNOWLEDGE_CORE_CONSOLE_DEFAULT_PROJECT=inbox

# Launcher-only setting: exact existing PostgreSQL container holding this KC database.
KNOWLEDGE_CORE_POSTGRES_CONTAINER=existing-kc-postgres-container
