  "policy": {
    "invariants": [
      {
        "rule_id": "P001",
        "statement": "Use only operator-approved credentials required by the selected provider transport; authentication does not grant task authority, and unrelated secrets must not be exposed to workers."
      },
      {
        "rule_id": "P002",
        "statement": "Strip GitHub credential-like variables from restricted worker subprocesses."
      },
      {
        "rule_id": "P003",
        "statement": "Use only explicit read-only or workspace-write sandbox modes; danger and full-access modes are forbidden."
      },
      {
        "rule_id": "P004",
        "statement": "Operate on a separate assigned target repository and remain inside exact task scope."
      },
      {
        "rule_id": "P005",
        "statement": "Stop at the first failed identity, authority, scope, sandbox, diff, test, or evidence boundary."
      },
      {
        "rule_id": "P006",
        "statement": "A worker may not modify the policy, role, evaluator, test selection, evidence integrity, or graduation rules judging its attempt."
      },
      {
        "rule_id": "P007",
        "statement": "A worker may not commit, publish, merge, approve, or grade its own candidate."
      },
      {
        "rule_id": "P008",
        "statement": "Never report an unexecuted or failed required check as passed."
      }
    ],
